# Copy to .env (next to jev_router.py) and fill in. Never commit .env.
TYPESAFE_API_KEY=your-typesafe-key

# Optional (defaults shown)
# JEV_LISTEN_HOST=127.0.0.1
# JEV_LISTEN_PORT=8787
# JEV_UPSTREAM=http://127.0.0.1:15721
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_REWRITE=1
# JEV_MODEL_LUNA=gpt-5.6-luna
# JEV_MODEL_TERRA=gpt-5.6-terra
# JEV_MODEL_SOL=gpt-5.6-sol
# JEV_MODEL_ASTRA=gpt-6-astra
# JEV_FALLBACK_MODEL=gpt-5.6-sol
# JEV_RETRY_MAX=2
# JEV_RETRY_DELAY=1.0
# JEV_LOG=./decisions.jsonl   # only written when JEV_DEBUG=1 / 仅 JEV_DEBUG=1 时写入
# JEV_DEBUG=0   # 1 = write decisions.jsonl, request headers and failing 400 requests (contain prompts; local only)
#               # 1 = 写 decisions.jsonl、请求头和失败的 400 请求（含提问内容，仅本地）
