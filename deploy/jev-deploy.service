[Unit]
Description=Deploy Jev Router main after GitHub CI succeeds
After=network-online.target jev-router.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
Environment=GIT_TERMINAL_PROMPT=0
Environment="GIT_SSH_COMMAND=ssh -o BatchMode=yes -o ConnectTimeout=15"
ExecStart=/usr/bin/python3 /usr/local/lib/jev-deploy/deploy.py
TimeoutStartSec=15min
